# =========================
# .env.example — copia a .env y reemplaza los valores
# =========================

# ── Supabase (solo servidor) ──────────────────────────────────────────
# El navegador ya no usa ninguna key: todo pasa por /api/db (routes/db.js).
# La anon key no tiene acceso a ninguna tabla desde la migración 001.
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Service Role Key — Dashboard → Settings → API. NO la subas a git.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Conexión directa (session pooler). Opcional: solo la usan
# npm run db:dump y npm run db:validar, que abren sesión READ ONLY.
SUPABASE_DB_URL=postgresql://postgres.TU_PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Cloudflare R2 (fotos) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=glp-fotos
R2_PUBLIC_URL=

# ── Web Push (opcional: sin las tres no hay notificaciones) ───────────
VAPID_SUBJECT=mailto:tu@correo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Despacho ──────────────────────────────────────────────────────────
DESPACHO_QR_SECRET=

# ── Otros ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
