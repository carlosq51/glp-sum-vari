# =========================
# .env.example - MIGRACIÓN PARALELA
# Copia esto a .env y reemplaza los valores
# =========================

# ══════════════════════════════════════════════════════════════════
# APPSCRIPT (Sistema actual - mantener como está)
# ══════════════════════════════════════════════════════════════════
APS_URL=https://script.google.com/macros/d/AQUI_TU_APPS_SCRIPT_ID/usercontent
APS_KEY=AQUI_TU_API_KEY_DE_APPS_SCRIPT

# ══════════════════════════════════════════════════════════════════
# SUPABASE (Sistema nuevo - agregar para migración)
# ══════════════════════════════════════════════════════════════════

# URL del proyecto Supabase (ej: https://rlmglp.supabase.co)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Service Role Key (solo servidor - máximos permisos)
# ⚠️ MANTÉN ESTO PRIVADO - NO lo compartas en git
# Localización: Dashboard → Settings → API → Service Role Key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon Key (para frontend - permisos limitados)
# Localización: Dashboard → Settings → API → anon key
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ══════════════════════════════════════════════════════════════════
# OTROS
# ══════════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development

# ══════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE MIGRACIÓN (opcional)
# ══════════════════════════════════════════════════════════════════

# Activa escritura dual (AppScript + Supabase)
# true = escribe en ambos | false = solo AppScript
DUAL_WRITE_ENABLED=true

# Si true, ignora errores de AppScript (continúa si Supabase falla)
IGNORE_APPSCRIPT_ERRORS=false

# Si true, ignora errores de Supabase (continúa si AppScript OK)
IGNORE_SUPABASE_ERRORS=true
